{
  "name": "jainav-site",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "tokens:build": "tsx scripts/tokens-build.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:migrations": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_MIGRATING=true payload run scripts/check-migrations.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed/run.ts",
    "seed:publish": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed/publish.ts",
    "seed:store": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed/store.ts",
    "import:release": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/import-release.ts",
    "gen:licensing-keys": "tsx scripts/gen-licensing-keys.ts",
    "license-test-client": "tsx scripts/license-test-client.ts",
    "prepare": "husky",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@marsidev/react-turnstile": "1.6.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@react-email/components": "1.0.12",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/nextjs": "11.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "^10.1.0",
    "graphql": "^16.8.1",
    "jose": "6.2.12",
    "lucide-react": "^1.57.0",
    "motion": "14.0.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "radix-ui": "1.6.7",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "semver": "^7.8.5",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "^7.8.0",
    "culori": "^4.0.2",
    "dotenv": "18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
