{
  "name": "jainav-site",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tokens:build": "tsx scripts/tokens-build.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "prepare": "husky"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "lucide-react": "^1.57.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "semver": "^7.8.5",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.8.0",
    "culori": "^4.0.2",
    "dotenv": "16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
