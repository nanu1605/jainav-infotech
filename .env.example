# Copy to .env and fill in. Values marked {{LIKE_THIS}} come from Tanishq (spec §21).

# Core
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jainav
PAYLOAD_SECRET=
CRON_SECRET=
# 1 on staging only: it sits behind basic auth (Caddy) and must never be indexed.
STAGING_BASIC_AUTH=
# Set to 1 in CI image builds: generateStaticParams returns [] so no DB is needed at build time.
SKIP_DB_AT_BUILD=
# 1 to serve /styleguide in a production build (staging). Always on in development.
ENABLE_STYLEGUIDE=

# Storage (Cloudflare R2; local disk when unset)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CDN_URL=
DOWNLOADS_BASE_URL=

# Email. Without RESEND_API_KEY, development writes emails to .outbox/; production starts, but every
# send fails and each start logs it and posts to Telegram. Servers need it: docs/runbooks/server.md.
# EMAIL_FROM is an address on the Resend sending domain, e.g. {{EMAIL_FROM}}; EMAIL_REPLY_TO is the
# fallback reply-to and alert inbox while site settings has no company emails.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Payments (test keys until Phase 10). All empty in development = the built-in stand-in gateway
# (src/app/api/v1/dev/razorpay); production refuses checkout without them. Staging: docs/runbooks/store.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Anti-spam. Empty in development = Cloudflare's always-pass test keys; required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Alerts (new leads; uptime from Phase 6). Empty = alerts are skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Customer sign-in codes (HMAC key). Required in production; development derives one.
OTP_PEPPER=

# Licensing (spec §12). `pnpm gen:licensing-keys` prints all four for a server's env file, see
# docs/runbooks/licensing.md; never commit them. Empty in development = keys derived from
# PAYLOAD_SECRET (kid "dev"); production refuses and the licensing API answers 503.
# LICENSING_PRIVATE_KEY: Ed25519 signing key (base64 PKCS#8 DER or PEM); LICENSING_KEY_ID: its kid.
# LICENSE_KEY_ENCRYPTION_KEY (stored key copies) and DEVICE_ID_PEPPER (device hashes) must never
# change once licenses exist.
LICENSING_PRIVATE_KEY=
LICENSING_KEY_ID=
LICENSE_KEY_ENCRYPTION_KEY=
DEVICE_ID_PEPPER=

# Analytics and errors. Empty = off. NEXT_PUBLIC_* values are baked in at build time (CI sets
# them per environment). SENTRY_DSN: server errors. NEXT_PUBLIC_SENTRY_DSN: browser errors
# (usually the same DSN). NEXT_PUBLIC_UMAMI_URL: the Umami origin, e.g. https://analytics.{{DOMAIN}}.
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Local dev admin for the seed script (development only)
DEV_ADMIN_EMAIL=admin@jainav.test
DEV_ADMIN_PASSWORD=

# Local tooling
# Optional GitHub token: raises the API rate limit for scripts/import-release.ts.
GITHUB_TOKEN=
# chrome = run Playwright on the installed Google Chrome instead of its downloaded Chromium.
PLAYWRIGHT_CHANNEL=
