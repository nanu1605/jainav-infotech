# Copy to .env and fill in. Values marked {{LIKE_THIS}} come from Tanishq (spec §21).

# Core
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jainav
PAYLOAD_SECRET=
CRON_SECRET=
STAGING_BASIC_AUTH=
# Set to 1 in CI image builds: generateStaticParams returns [] so no DB is needed at build time.
SKIP_DB_AT_BUILD=
# 1 to serve /styleguide in a production build (staging). Always on in development.
ENABLE_STYLEGUIDE=

# Storage (Cloudflare R2; local disk when unset)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CDN_URL=
DOWNLOADS_BASE_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Payments (test keys until Phase 10)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Anti-spam
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Customer sign-in
OTP_PEPPER=

# Licensing
LICENSING_PRIVATE_KEY=
LICENSING_KEY_ID=
LICENSE_KEY_ENCRYPTION_KEY=
DEVICE_ID_PEPPER=

# Analytics and errors
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Local dev admin for the seed script (development only)
DEV_ADMIN_EMAIL=admin@jainav.test
DEV_ADMIN_PASSWORD=

# Local tooling
# chrome = run Playwright on the installed Google Chrome instead of its downloaded Chromium.
PLAYWRIGHT_CHANNEL=
