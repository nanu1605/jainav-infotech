# /srv/edge/edge.env on the VPS (0600): the values the site files read as {$JAINAV_…}
# (docker/edge/config/sites). Every value must be set: a site file is refused while one is empty.
# A container's environment is fixed when it is created, so recreate Caddy after a change
# (docs/runbooks/edge.md).

# Every name starts with the ENV_PREFIX of an app in /etc/apps (JAINAV_ here): app-apply refuses any
# other name, because Caddy and Docker read some variables themselves.

# Jainav's public domain, without https:// (Caddy serves it, www., staging. and analytics.).
JAINAV_DOMAIN=jainavinfotech.in

# Staging's basic auth. The hash comes from:
#   docker run --rm caddy:<the tag in compose.yml> caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains $ signs.
JAINAV_STAGING_AUTH_USER=jainav
JAINAV_STAGING_AUTH_HASH='$2a$14$replace-me'
