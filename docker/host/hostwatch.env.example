# /etc/hostwatch.env on the server (root:root 0600): the server's Telegram bot and its heartbeat.
# install.sh copies this file only if the real one does not exist yet. One KEY=value per line; quotes
# are not needed, and not read as part of a URL.

# The server's own bot from @BotFather (one bot per sender, so every message says where it came
# from: [server], [jainav]...), and the ops chat's id: message the bot, then open
# https://api.telegram.org/bot<token>/getUpdates. Empty: alerts go to the journal only.
BOT_TOKEN=
CHAT_ID=

# The heartbeat monitor's ping URL, called after every 5-minute run (15 minutes of grace).
# Empty: no heartbeat.
HEARTBEAT_URL=
