# Every 5 minutes, on the 5. The heartbeat monitor expects a ping at this rate with 15 minutes of
# grace, so a hung or unreachable server is noticed (docs/runbooks/monitoring.md).
[Unit]
Description=Host checks every 5 minutes

[Timer]
OnCalendar=*:0/5
AccuracySec=10s

[Install]
WantedBy=timers.target
