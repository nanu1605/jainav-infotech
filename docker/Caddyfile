# Origin web server (spec §16, §18). Cloudflare terminates visitors' TLS and connects here over
# HTTPS with SSL "Full (strict)", so every site uses the Cloudflare Origin CA certificate.
# Compression and caching headers come from Next.js and Cloudflare.

# What a log line keeps of a request: its time, method, host, path, status, size and duration, and
# Cloudflare's address (Caddy trusts no proxy). Gone are request headers (visitor IPs, Access
# identities), response headers (Location holds 5-minute signed file URLs), staging's login name,
# the whole query string (newsletter tokens, order numbers, form prefills) and the token in Payload's
# password reset path. A path can still identify a record.
(log_fields) {
	wrap json
	request>headers delete
	request>uri regexp (/admin/reset)/[^?]*|\?.* ${1}
	resp_headers delete
	headers delete
	user_id delete
}

{
	# No automatic certificates: the Origin CA certificate is mounted at /certs.
	auto_https disable_redirects
	# Every other log, because upstream errors (e.g. the app restarting) log the whole request.
	log default {
		format filter {
			import log_fields
		}
	}
}

(origin) {
	tls /certs/origin.pem /certs/origin-key.pem
	# Installer uploads in the admin (Cloudflare's free plan caps a request at 100 MB anyway).
	request_body {
		max_size 110MB
	}
	log {
		output stdout
		format filter {
			import log_fields
		}
	}
}

{$DOMAIN} {
	import origin
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	import origin
	redir https://{$DOMAIN}{uri} 308
}

# Staging: basic auth everywhere except the machine-to-machine APIs (spec §18.1), and never
# indexed. STAGING_AUTH_HASH comes from `caddy hash-password`.
staging.{$DOMAIN} {
	import origin
	header X-Robots-Tag "noindex, nofollow"
	@protected not path /api/v1/webhooks/* /api/v1/licensing/* /api/v1/updates/* /api/v1/downloads/*
	basic_auth @protected {
		{$STAGING_AUTH_USER} {$STAGING_AUTH_HASH}
	}
	reverse_proxy app-staging:3000
}

analytics.{$DOMAIN} {
	import origin
	reverse_proxy umami:3000
}
