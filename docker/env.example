# /srv/jainav/.env on the VPS: values docker/compose.prod.yml reads (docs/runbooks/server.md).
# The apps' own settings go in production.env and staging.env (keys from /.env.example).
# Generate every password and secret with: openssl rand -base64 32 | tr -d '/+='
# Caddy's values (the domain, staging's login) are in docker/edge/edge.env.example.

# The images (APP_IMAGE, STAGING_IMAGE, BACKUP_IMAGE) are not set here but in images.env, which only
# app-deploy writes; docker/images.env.example is its starting point. The backup image's tag,
# backup-<commit>, comes from the "Backup image" workflow's job summary.

# Postgres: the superuser, then one role per database (read once, when the volume is created).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
STAGING_DB_PASSWORD=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Backups (docs/runbooks/backups.md): the age public key (age1…), the R2 bucket and an R2 API
# token with read and write access to that bucket only.
BACKUP_AGE_RECIPIENT=
BACKUP_BUCKET=jainav-backups
BACKUP_S3_ENDPOINT=https://{{CLOUDFLARE_ACCOUNT_ID}}.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Days of Umami data to keep, at least 30; empty keeps it all (docs/runbooks/retention.md).
UMAMI_RETENTION_DAYS=

# Failure alerts from the backup job (the same bot and chat as the site's alerts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A monitor's heartbeat URL, pinged after every successful backup; empty skips it. The monitor
# should alert when no ping comes for 26 hours (docs/runbooks/monitoring.md).
BACKUP_HEARTBEAT_URL=
