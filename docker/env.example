# /srv/jainav/.env on the VPS: values docker/compose.prod.yml reads (docs/runbooks/server.md).
# The apps' own settings go in production.env and staging.env (keys from /.env.example).
# Generate every password and secret with: openssl rand -base64 32 | tr -d '/+='

# Public domain, without https:// (Caddy serves it, www., staging. and analytics.)
DOMAIN={{DOMAIN}}

# Set by deploy.sh on every deploy; the first values are the first images CI pushed.
APP_IMAGE=ghcr.io/nanu1605/jainav-infotech:prod-v0.0.0
STAGING_IMAGE=ghcr.io/nanu1605/jainav-infotech:staging-0000000

# Postgres: the superuser, then one role per database (read once, when the volume is created).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
STAGING_DB_PASSWORD=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Staging basic auth. The hash comes from:
#   docker run --rm caddy:2.11.6-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains $ signs.
STAGING_AUTH_USER=jainav
STAGING_AUTH_HASH='$2a$14$replace-me'

# Backups (docs/runbooks/backups.md): the age public key (age1…), the R2 bucket and an R2 API
# token with read and write access to that bucket only.
BACKUP_AGE_RECIPIENT=
BACKUP_BUCKET=jainav-backups
BACKUP_S3_ENDPOINT=https://{{CLOUDFLARE_ACCOUNT_ID}}.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Failure alerts from the backup job (the same bot and chat as the site's alerts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
