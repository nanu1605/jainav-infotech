# /srv/jainav/images.env (0644): the image each service runs, read by compose after .env. Only
# app-deploy writes the real file, one line per deploy; start the server's copy from this one.
# ":none" means never deployed: a first deploy that fails stops its service instead of rolling
# back.
APP_IMAGE=ghcr.io/nanu1605/jainav-infotech:none
STAGING_IMAGE=ghcr.io/nanu1605/jainav-infotech:none
BACKUP_IMAGE=ghcr.io/nanu1605/jainav-infotech:none
